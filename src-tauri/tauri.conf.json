{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NotchFlow",
  "version": "0.1.0",
  "identifier": "com.notchflow.app",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:5173", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "NotchFlow", "width": 1200, "height": 820, "minWidth": 900, "minHeight": 650, "resizable": true }], "security": { "csp": "default-src 'self'; connect-src 'self' https:; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:;" } },
  "bundle": { "active": true, "targets": "msi", "windows": { "wix": { "language": "en-US" } } }
}
